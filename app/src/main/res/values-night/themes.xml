<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MavJegy" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Sotet mod: fekete splash-hatter, ugyanaz a kek jegy ikon
         (a notchok/pottyok evenOdd lyukak, igy feketek maradnak) -->
    <style name="Theme.MavJegy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.MavJegy</item>
    </style>
</resources>
